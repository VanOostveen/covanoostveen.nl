---
import Basis from '../layouts/Basis.astro';
import Lijst from '../components/Lijst.astro';
import { profiel } from '../data/profiel';
import { getStukken } from '../lib/stukken';

const stukken = await getStukken();

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: profiel.naam,
    url: profiel.site,
    inLanguage: 'nl',
    author: { '@type': 'Person', name: profiel.naam, url: `${profiel.site}/over/` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: profiel.naam,
    jobTitle: profiel.functieKort,
    url: `${profiel.site}/over/`,
  },
];
---

<Basis beschrijving={`${profiel.naam}. ${profiel.functie}`} jsonld={jsonld}>
  <p class="intro">{profiel.functie}</p>
  <ul class="bewijs">
    {profiel.bewijs.map((b) => (
      <li><a href={b.url}>{b.label}</a></li>
    ))}
  </ul>
  <Lijst stukken={stukken} />
</Basis>
