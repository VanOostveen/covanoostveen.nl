---
import '@fontsource/source-serif-4/latin-400.css';
import '@fontsource/source-serif-4/latin-400-italic.css';
import '@fontsource/source-serif-4/latin-500.css';
import '../styles/global.css';
import { profiel, secties } from '../data/profiel';

interface Props {
  titel?: string;
  beschrijving: string;
  canonical?: string;
  taal?: 'nl' | 'en';
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
}

const { titel, beschrijving, canonical, taal = 'nl', jsonld } = Astro.props;
const paginaTitel = titel ? `${titel} · ${profiel.naam}` : profiel.naam;
const huidig = Astro.url.pathname;
const canoniek = canonical ?? new URL(huidig, Astro.site).href;
const isHuidig = (p: string) => huidig.startsWith(p);
---

<!doctype html>
<html lang={taal}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{paginaTitel}</title>
    <meta name="description" content={beschrijving} />
    <meta name="author" content={profiel.naam} />
    <meta name="theme-color" content="#10201a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canoniek} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${profiel.naam}: alles`} href="/feed.xml" />
    {
      Object.entries(secties)
        .filter(([s]) => s !== 'publicaties')
        .map(([s, { titel }]) => (
          <link rel="alternate" type="application/rss+xml" title={`${profiel.naam}: ${titel.toLowerCase()}`} href={`/${s}/feed.xml`} />
        ))
    }
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <script is:inline>
      // Donker is de standaard. Wie voor licht kiest, wordt onthouden in localStorage.
      try {
        if (localStorage.getItem('thema') === 'light') document.documentElement.dataset.theme = 'light';
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="pagina">
      <header class="kop">
        <a class="merk" href="/" aria-label={profiel.naam}>{profiel.merk}</a>
        <nav aria-label="Menu">
          <a href="/publicaties/" aria-current={isHuidig('/publicaties/') ? 'page' : undefined}>Publicaties</a>
          <a href="/over/" aria-current={isHuidig('/over/') ? 'page' : undefined}>Over</a>
          <button class="knop" type="button" id="thema" aria-label="Wissel tussen donker en licht">
            <svg class="zon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"></path></svg>
            <svg class="maan" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
          </button>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="voet">
        {profiel.voetRegels.map((regel) => <p>{regel}</p>)}
        <p><a href="/feed.xml">RSS</a></p>
      </footer>
    </div>
    <script is:inline>
      document.getElementById('thema').addEventListener('click', function () {
        var d = document.documentElement.dataset;
        var nieuw = d.theme === 'light' ? 'dark' : 'light';
        if (nieuw === 'light') d.theme = 'light';
        else delete d.theme;
        try { localStorage.setItem('thema', nieuw); } catch (e) {}
      });
    </script>
  </body>
</html>
