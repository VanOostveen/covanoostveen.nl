---
import { pad, iso, type Stuk } from '../lib/stukken';
import { sectieVanType } from '../data/profiel';

interface Props {
  stukken: Stuk[];
  metType?: boolean;
}

const { stukken, metType = true } = Astro.props;
---

{
  stukken.length === 0 ? (
    <p class="leeg">Nog niets.</p>
  ) : (
    <ol class="lijst">
      {stukken.map((s) => (
        <li>
          <time class="datum" datetime={iso(s.data.datum)}>{iso(s.data.datum)}</time>
          <span>
            <a class="titel" href={pad(s)}>
              {s.data.titel}
              {s.data.concept && <span class="concept"> (concept)</span>}
            </a>
            {metType && <a class="type" href={`/${sectieVanType[s.data.type]}/`}>{s.data.type}</a>}
          </span>
        </li>
      ))}
    </ol>
  )
}
